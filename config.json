{
  "type": "Settings",
  "audio": {
    "input": {
      "encoding": "linear16",
      "sample_rate": 48000
    },
    "output": {
      "encoding": "linear16",
      "sample_rate": 24000,
      "container": "none"
    }
  },
  "agent": {
    "speak": {
      "provider": {
        "type": "deepgram",
        "model": "aura-2-thalia-en"
      }
    },
    "listen": {
      "provider": {
        "type": "deepgram",
        "version": "v2",
        "model": "flux-general-en",
        "eot_threshold": 0.6,
        "eot_timeout_ms": 2000
      }
    },
    "think": {
      "provider": {
        "type": "openrouter",
        "model": "openrouter/free"
      },
      "prompt": "",
      "max_completion_tokens": 3072
    },
    "greeting": "Hey! I'm Grace. What are we making today?"
  }
}
