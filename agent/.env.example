LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret
DEEPGRAM_API_KEY=your_deepgram_key
GOOGLE_API_KEY=your_google_key          # if config.json think.provider.type = "google"
OPENROUTER_API_KEY=your_openrouter_key  # if config.json think.provider.type = "openrouter"
OPENAI_API_KEY=your_openai_key          # if config.json think.provider.type = "openai"

# Neon PostgreSQL (https://neon.tech)
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# JWT secret for user auth (change in production)
JWT_SECRET=your-random-secret-here
