# Copy to .env and fill in your values:
#   cp .env.example .env

# --- LiveKit (https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret

# --- Speech & LLM ---
DEEPGRAM_API_KEY=your_deepgram_key
OPENROUTER_API_KEY=your_openrouter_key
# GOOGLE_API_KEY=...   # if config.json uses google
# OPENAI_API_KEY=...   # if config.json uses openai

# --- Database (local PostgreSQL) ---
# For local dev without Docker. Docker Compose overrides POSTGRES_HOST automatically.
# Equivalent URL: postgresql://voiceagent:voiceagent@localhost:5432/voiceagent
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=voiceagent
POSTGRES_DB=voiceagent

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Web server ---
PORT=8000

# Production (https://assistantchef.cc) — used by docker-compose.yml
# Frontend and API are same-origin; VITE_API_BASE stays empty in the Docker build.
# TRUST_PROXY=1
# CORS_ORIGINS=https://assistantchef.cc,https://www.assistantchef.cc

# Demo user password (used by npm run seed)
# DEMO_PASSWORD=demo1234
