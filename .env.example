# Copy to .env and fill in your values:
#   cp .env.example .env

# --- LiveKit (https://cloud.livekit.io) ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_key
LIVEKIT_API_SECRET=your_secret

# --- Speech & LLM ---
DEEPGRAM_API_KEY=your_deepgram_key
OPENROUTER_API_KEY=your_openrouter_key
# GOOGLE_API_KEY=...   # if config.json uses google
# OPENAI_API_KEY=...   # if config.json uses openai

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- Web server ---
PORT=8000

# Public URL of your app (for CORS when frontend is on a different domain)
# CORS_ORIGINS=https://your-domain.com

# Set to 1 when running behind nginx/caddy with reverse proxy
# TRUST_PROXY=1
